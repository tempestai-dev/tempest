{
  "expo": {
    "name": "Tempest",
    "slug": "tempest-mobile",
    "scheme": "tempest",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tempestai.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Tempest connects to your paired laptop over your local Wi-Fi to drive your agents."
      }
    },
    "android": {
      "package": "com.tempestai.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Tempest uses the camera to scan the pairing QR shown by your desktop."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8ce33113-9b4d-4a44-9760-0a29efb472f9"
      }
    },
    "owner": "usetempest"
  }
}
